# Copy to .env and fill in.

# --- Local development -------------------------------------------------------
# Point at a Postgres you can reach. With the Compose stack running you can
# publish the db port temporarily, or run a separate local instance.
DATABASE_URL="postgres://deadlyft:password@localhost:5432/deadlyft"

# Signs the session cookie. Generate one with:
#   openssl rand -base64 32
# Changing it signs everyone out, which is how you revoke every session at once.
SESSION_SECRET=""

# --- Deployment (docker compose) ---------------------------------------------
# The Compose stack builds DATABASE_URL from these three, so don't set it there.
# The app reaches Postgres over the private Compose network as host "db".
POSTGRES_USER="deadlyft"
POSTGRES_PASSWORD=""
POSTGRES_DB="deadlyft"

# Encrypts the variables a Server Action closes over. Next generates one at
# build time if this is unset, which would change on every deploy — so pin it,
# with another:
#   openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# Note: in production the session cookie is set Secure, so the app only works
# behind HTTPS. Over plain HTTP the browser silently drops the cookie and every
# sign-in bounces straight back to the login page.
